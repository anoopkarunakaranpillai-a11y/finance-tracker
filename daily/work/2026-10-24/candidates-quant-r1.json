[
{"k":"quant-1401","cat":"quant","s":"math","t":"Percentage","lvl":"recruit","exam":"Kerala PSC","psc":"sslc","d":"easy","q":"ഒരു സംഖ്യയുടെ 12½% 75 ആണ്. ആ സംഖ്യ ഏത്?","o":["600","500","750","900"],"a":0,"e":"സംഖ്യ = 75 × 100 ÷ 12.5 = 600.","lang":"ml","calc":"75*100/12.5"},
{"k":"quant-1402","cat":"quant","s":"math","t":"Profit and loss","lvl":"recruit","exam":"Kerala PSC","psc":"sslc","d":"medium","q":"ഒരു കച്ചവടക്കാരൻ കിലോയ്ക്ക് ₹30 നിരക്കിൽ 40 കി.ഗ്രാം പഞ്ചസാര വാങ്ങി. അതിൽ 25 കി.ഗ്രാം കിലോയ്ക്ക് ₹36 നിരക്കിലും ബാക്കി കിലോയ്ക്ക് ₹33 നിരക്കിലും വിറ്റു. ആകെ ലാഭശതമാനം എത്ര?","o":["15%","16.25%","17.5%","18%"],"a":1,"e":"വാങ്ങിയ വില 1200; വിറ്റ വില 900 + 495 = 1395; ലാഭം 195; 195 ÷ 1200 × 100 = 16.25%.","lang":"ml","calc":"(25*36+15*33-40*30)*100/(40*30)"},
{"k":"quant-1403","cat":"quant","s":"math","t":"Simple interest","lvl":"recruit","exam":"Kerala PSC","psc":"sslc","d":"easy","q":"₹5000-ന് 8% വാർഷിക സാധാരണ പലിശ നിരക്കിൽ 9 മാസത്തെ പലിശ എത്ര?","o":["₹250","₹360","₹300","₹400"],"a":2,"e":"പലിശ = 5000 × 8 × 9 ÷ (100 × 12) = ₹300.","lang":"ml","calc":"5000*8*9/1200"},
{"k":"quant-1404","cat":"quant","s":"math","t":"Compound interest (half-yearly)","lvl":"recruit","exam":"Kerala PSC","psc":"degree","d":"hard","q":"₹8000-ന് 10% വാർഷിക നിരക്കിൽ, ആറുമാസത്തിലൊരിക്കൽ കൂട്ടുന്ന കൂട്ടുപലിശ പ്രകാരം 1½ വർഷത്തെ കൂട്ടുപലിശ എത്ര?","o":["₹1200","₹1240","₹1280","₹1261"],"a":3,"e":"ആറുമാസ നിരക്ക് 5%, 3 കാലയളവ്: തുക = 8000 × (21/20)³ = 9261; കൂട്ടുപലിശ = ₹1261.","lang":"ml","calc":"8000*21^3/20^3-8000"},
{"k":"quant-1405","cat":"quant","s":"math","t":"Ratio and proportion","lvl":"recruit","exam":"Kerala PSC","psc":"sslc","d":"medium","q":"₹2340 A, B, C എന്നിവർക്ക് 2A = 3B = 4C ആകുന്ന വിധത്തിൽ വീതിച്ചാൽ C-യ്ക്ക് കിട്ടുന്ന തുക എത്ര?","o":["₹720","₹540","₹1080","₹600"],"a":1,"e":"A : B : C = 1/2 : 1/3 : 1/4 = 6 : 4 : 3; C = 2340 × 3/13 = ₹540.","lang":"ml","calc":"2340*3/13"},
{"k":"quant-1406","cat":"quant","s":"math","t":"Averages","lvl":"recruit","exam":"Kerala PSC","psc":"plus2","d":"medium","q":"ഒരു ടീമിലെ 11 കളിക്കാരുടെ ശരാശരി വയസ്സ് 25 ആണ്. 28 വയസ്സുള്ള ക്യാപ്റ്റനെയും 31 വയസ്സുള്ള വിക്കറ്റ്കീപ്പറെയും ഒഴിവാക്കിയാൽ ബാക്കി കളിക്കാരുടെ ശരാശരി വയസ്സ് എത്ര?","o":["23","24.5","24","22"],"a":2,"e":"ആകെ 275; 275 − 28 − 31 = 216; 216 ÷ 9 = 24.","lang":"ml","calc":"(11*25-28-31)/9"},
{"k":"quant-1407","cat":"quant","s":"math","t":"Time and work (efficiency)","lvl":"recruit","exam":"Kerala PSC","psc":"plus2","d":"hard","q":"B ഒരു ജോലി 30 ദിവസം കൊണ്ട് തീർക്കും. A, B-യേക്കാൾ 50% കൂടുതൽ കാര്യക്ഷമതയുള്ളയാളാണ്. ഇരുവരും ഒരുമിച്ച് ആ ജോലി എത്ര ദിവസം കൊണ്ട് തീർക്കും?","o":["15","10","18","12"],"a":3,"e":"A-യ്ക്ക് 20 ദിവസം; ഒരു ദിവസത്തെ ജോലി 1/30 + 1/20 = 1/12; അതിനാൽ 12 ദിവസം.","lang":"ml","calc":"30/(1+1.5)"},
{"k":"quant-1408","cat":"quant","s":"math","t":"Speed, time and distance","lvl":"recruit","exam":"Kerala PSC","psc":"sslc","d":"easy","q":"ഒരാൾ 750 മീറ്റർ ദൂരം 9 മിനിറ്റ് കൊണ്ട് നടക്കുന്നു. അയാളുടെ വേഗം മണിക്കൂറിൽ എത്ര കി.മീ.?","o":["5","4.5","6","5.5"],"a":0,"e":"0.75 കി.മീ. ÷ (9/60) മണിക്കൂർ = 5 കി.മീ./മണിക്കൂർ.","lang":"ml","calc":"0.75*60/9"},
{"k":"quant-1409","cat":"quant","s":"math","t":"Mixtures (alligation)","lvl":"recruit","exam":"Kerala PSC","psc":"plus2","d":"medium","q":"60% പഞ്ചസാര അടങ്ങിയ 10 ലിറ്റർ ലായനിയിൽ 30% പഞ്ചസാര അടങ്ങിയ ലായനി എത്ര ലിറ്റർ ചേർത്താൽ മിശ്രിതത്തിൽ 40% പഞ്ചസാര ആകും?","o":["15 ലിറ്റർ","20 ലിറ്റർ","25 ലിറ്റർ","10 ലിറ്റർ"],"a":1,"e":"കൂട്ടിക്കലർത്തൽ നിയമം: 30% : 60% = (60−40) : (40−30) = 2 : 1; അതിനാൽ 10 × 2 = 20 ലിറ്റർ.","lang":"ml","calc":"10*(60-40)/(40-30)"},
{"k":"quant-1410","cat":"quant","s":"math","t":"Mensuration (recasting solids)","lvl":"recruit","exam":"Kerala PSC","psc":"degree","d":"hard","q":"ആരം 3 സെ.മീ. ആയ ഒരു ലോഹഗോളം ഉരുക്കി ആരം 2 സെ.മീ. ആയ ഒരു വൃത്തസ്തംഭമാക്കി (സിലിണ്ടർ). സിലിണ്ടറിന്റെ ഉയരം എത്ര?","o":["6 സെ.മീ.","12 സെ.മീ.","9 സെ.മീ.","8 സെ.മീ."],"a":2,"e":"(4/3)π × 3³ = π × 2² × h ⇒ 36 = 4h ⇒ h = 9 സെ.മീ.","lang":"ml","calc":"4*3^3/(3*2^2)"},
{"k":"quant-1411","cat":"quant","s":"math","t":"Place value and face value","lvl":"recruit","exam":"Kerala PSC","psc":"sslc","d":"easy","q":"573849 എന്ന സംഖ്യയിലെ 7-ന്റെ സ്ഥാനവിലയും മുഖവിലയും തമ്മിലുള്ള വ്യത്യാസം എത്ര?","o":["70007","69990","7000","69993"],"a":3,"e":"7-ന്റെ സ്ഥാനവില 70000, മുഖവില 7; വ്യത്യാസം 69993.","lang":"ml","calc":"70000-7"},
{"k":"quant-1412","cat":"quant","s":"math","t":"HCF application (tiles)","lvl":"recruit","exam":"Kerala PSC","psc":"degree","d":"advanced","q":"15 മീ. 17 സെ.മീ. നീളവും 9 മീ. 2 സെ.മീ. വീതിയുമുള്ള ഒരു മുറിയുടെ തറ ഒരേ വലിപ്പമുള്ള സമചതുര ടൈലുകൾ കൊണ്ട് പൂർണമായി പാകണം. ഏറ്റവും കുറഞ്ഞത് എത്ര ടൈലുകൾ വേണം?","o":["814","714","841","902"],"a":0,"e":"1517, 902 എന്നിവയുടെ ഉ.സാ.ഘ. 41 സെ.മീ. = ടൈലിന്റെ വശം; ടൈലുകൾ = 37 × 22 = 814.","lang":"ml","calc":"(1517/41)*(902/41)"},
{"k":"quant-1413","cat":"quant","s":"math","t":"Problems on ages","lvl":"recruit","exam":"Kerala PSC","psc":"degree","d":"hard","q":"അച്ഛന്റെയും മകന്റെയും ഇപ്പോഴത്തെ വയസ്സുകളുടെ തുക 45 ആണ്. 5 വർഷം മുമ്പ് അവരുടെ വയസ്സുകളുടെ ഗുണനഫലം അന്നത്തെ അച്ഛന്റെ വയസ്സിന്റെ 4 മടങ്ങായിരുന്നു. മകന്റെ ഇപ്പോഴത്തെ വയസ്സ് എത്ര?","o":["6","9","10","8"],"a":1,"e":"(F−5)(S−5) = 4(F−5) ⇒ S − 5 = 4 ⇒ S = 9 (അച്ഛന് 36). ഉത്തരം 9.","lang":"ml","calc":"4+5"},
{"k":"quant-1414","cat":"quant","s":"math","t":"Fractions","lvl":"recruit","exam":"Kerala PSC","psc":"sslc","d":"medium","q":"ഒരാൾ ശമ്പളത്തിന്റെ 1/3 ഭാഗം വീട്ടുവാടകയ്ക്കും ബാക്കിയുടെ 1/4 ഭാഗം ഭക്ഷണത്തിനും ചെലവാക്കുന്നു. ഇനി ₹9000 ബാക്കിയുണ്ടെങ്കിൽ അയാളുടെ ശമ്പളം എത്ര?","o":["₹27000","₹24000","₹18000","₹21600"],"a":2,"e":"ബാക്കി = S × 2/3 × 3/4 = S/2 = 9000 ⇒ ശമ്പളം ₹18000.","lang":"ml","calc":"9000*3*4/(2*3)"},
{"k":"quant-1415","cat":"quant","s":"math","t":"Powers and roots","lvl":"recruit","exam":"Kerala PSC","psc":"plus2","d":"easy","q":"(27)^(2/3) + (16)^(3/4)-ന്റെ വില എത്ര?","o":["15","19","21","17"],"a":3,"e":"27^(2/3) = 3² = 9; 16^(3/4) = 2³ = 8; 9 + 8 = 17.","lang":"ml","calc":"3^2+2^3"},
{"k":"quant-1416","cat":"quant","s":"math","t":"Partnership","lvl":"recruit","exam":"Kerala PSC","psc":"plus2","d":"medium","q":"A ₹45000 മുടക്കി ഒരു കച്ചവടം തുടങ്ങി. 4 മാസം കഴിഞ്ഞ് B ₹54000 മുടക്കി പങ്കാളിയായി. വർഷാവസാനം ആകെ ലാഭം ₹27000 ആയാൽ B-യുടെ വിഹിതം എത്ര?","o":["₹12000","₹15000","₹13500","₹10800"],"a":0,"e":"45000 × 12 : 54000 × 8 = 5 : 4; B-യുടെ വിഹിതം 27000 × 4/9 = ₹12000.","lang":"ml","calc":"27000*4/9"},
{"k":"quant-1417","cat":"quant","s":"math","t":"Successive percentage change","lvl":"recruit","exam":"Kerala PSC","psc":"plus2","d":"medium","q":"ഒരു ഗ്രാമത്തിലെ ജനസംഖ്യ ആദ്യ വർഷം 10% വർദ്ധിക്കുകയും രണ്ടാം വർഷം 10% കുറയുകയും ചെയ്തു. ഇപ്പോഴത്തെ ജനസംഖ്യ 7920 ആയാൽ ആദ്യത്തെ ജനസംഖ്യ എത്ര?","o":["7900","8000","8100","7840"],"a":1,"e":"P × 110/100 × 90/100 = 7920 ⇒ P = 7920 ÷ 0.99 = 8000.","lang":"ml","calc":"7920*100*100/(110*90)"},
{"k":"quant-1418","cat":"quant","s":"math","t":"Circular track","lvl":"recruit","exam":"Kerala PSC","psc":"degree","d":"advanced","q":"600 മീ. ചുറ്റളവുള്ള ഒരു വൃത്താകൃതിയിലുള്ള ട്രാക്കിൽ A-യും B-യും ഒരേ സ്ഥലത്തുനിന്ന് ഒരേ ദിശയിൽ യഥാക്രമം സെക്കൻഡിൽ 4 മീ., 6 മീ. വേഗത്തിൽ ഓടാൻ തുടങ്ങുന്നു. ഇരുവരും ആദ്യമായി വീണ്ടും ആരംഭസ്ഥലത്ത് ഒരുമിച്ചെത്തുന്നത് എത്ര മിനിറ്റ് കഴിഞ്ഞാണ്?","o":["2.5","10","5","6"],"a":2,"e":"ഒരു റൗണ്ടിന് A-യ്ക്ക് 150 സെ., B-യ്ക്ക് 100 സെ.; ല.സാ.ഗു. 300 സെ. = 5 മിനിറ്റ്.","lang":"ml","calc":"600/4*2/60"}
]
