[
{"k":"quant-1001","cat":"quant","s":"quant","t":"Percentage","lvl":"recruit","exam":"Kerala PSC","psc":"sslc","d":"easy","q":"450-ന്റെ 18% എത്ര?","o":["72","81","90","63"],"a":1,"e":"450 × 18/100 = 81. ഉത്തരം 81.","lang":"ml","calc":"450*18/100"},
{"k":"quant-1002","cat":"quant","s":"quant","t":"Profit and loss","lvl":"recruit","exam":"Kerala PSC","psc":"plus2","d":"medium","q":"ഒരു കച്ചവടക്കാരൻ ₹5-ന് 6 മാമ്പഴം എന്ന നിരക്കിൽ വാങ്ങി ₹6-ന് 5 മാമ്പഴം എന്ന നിരക്കിൽ വിൽക്കുന്നു. ലാഭശതമാനം എത്ര?","o":["20%","36%","44%","50%"],"a":2,"e":"ഒന്നിന്റെ വാങ്ങിയ വില ₹5/6, വിറ്റ വില ₹6/5. (6/5) ÷ (5/6) = 36/25; ലാഭം = 11/25 = 44%.","lang":"ml","calc":"(36-25)*100/25"},
{"k":"quant-1003","cat":"quant","s":"quant","t":"Simple interest","lvl":"recruit","exam":"Kerala PSC","psc":"sslc","d":"easy","q":"₹3600-ന് 8% വാർഷിക സാധാരണ പലിശ നിരക്കിൽ 2½ വർഷത്തെ പലിശ എത്ര?","o":["₹720","₹640","₹760","₹800"],"a":0,"e":"പലിശ = 3600 × 8 × 2.5 / 100 = ₹720.","lang":"ml","calc":"3600*8*2.5/100"},
{"k":"quant-1004","cat":"quant","s":"quant","t":"Compound interest (principal)","lvl":"recruit","exam":"Kerala PSC","psc":"degree","d":"hard","q":"20% വാർഷിക കൂട്ടുപലിശ നിരക്കിൽ (വർഷംതോറും കൂട്ടുന്നത്) 2 വർഷം കൊണ്ട് ₹7200 ആയിത്തീരുന്ന മുതൽ എത്ര?","o":["₹4800","₹5200","₹5500","₹5000"],"a":3,"e":"P × (1.2)² = 7200 ⇒ P = 7200 / 1.44 = ₹5000.","lang":"ml","calc":"7200*100*100/(120*120)"},
{"k":"quant-1005","cat":"quant","s":"quant","t":"Time and work","lvl":"recruit","exam":"Kerala PSC","psc":"sslc","d":"medium","q":"A, B, C എന്നിവർ ഒരു ജോലി യഥാക്രമം 10, 15, 30 ദിവസം കൊണ്ട് തനിയെ ചെയ്തുതീർക്കും. മൂവരും ഒരുമിച്ച് ജോലി ചെയ്താൽ എത്ര ദിവസം കൊണ്ട് തീരും?","o":["4 ദിവസം","5 ദിവസം","6 ദിവസം","7.5 ദിവസം"],"a":1,"e":"ഒരു ദിവസത്തെ ജോലി = 1/10 + 1/15 + 1/30 = 6/30 = 1/5. അതിനാൽ 5 ദിവസം.","lang":"ml","calc":"30/(3+2+1)"},
{"k":"quant-1006","cat":"quant","s":"quant","t":"Pipes and cisterns (leak)","lvl":"recruit","exam":"Kerala PSC","psc":"plus2","d":"medium","q":"ഒരു പൈപ്പ് ഒഴിഞ്ഞ ടാങ്ക് 4 മണിക്കൂർ കൊണ്ട് നിറയ്ക്കും. ടാങ്കിന്റെ അടിയിലുള്ള ഒരു ചോർച്ച കാരണം നിറയാൻ 5 മണിക്കൂർ എടുത്തു. നിറഞ്ഞ ടാങ്ക് ചോർച്ച വഴി മാത്രം എത്ര മണിക്കൂർ കൊണ്ട് കാലിയാകും?","o":["9 മണിക്കൂർ","16 മണിക്കൂർ","20 മണിക്കൂർ","24 മണിക്കൂർ"],"a":2,"e":"ചോർച്ചയുടെ നിരക്ക് = 1/4 − 1/5 = 1/20. അതിനാൽ 20 മണിക്കൂർ.","lang":"ml","calc":"4*5/(5-4)"},
{"k":"quant-1007","cat":"quant","s":"quant","t":"Train crossing a bridge","lvl":"recruit","exam":"Kerala PSC","psc":"plus2","d":"medium","q":"240 മീ. നീളമുള്ള ഒരു ട്രെയിൻ ഒരു വൈദ്യുതത്തൂൺ 16 സെക്കൻഡ് കൊണ്ട് കടന്നുപോകുന്നു. അതേ വേഗത്തിൽ 360 മീ. നീളമുള്ള ഒരു പാലം കടക്കാൻ ട്രെയിനിന് എത്ര സമയം വേണം?","o":["24 സെക്കൻഡ്","30 സെക്കൻഡ്","36 സെക്കൻഡ്","40 സെക്കൻഡ്"],"a":3,"e":"വേഗം = 240/16 = 15 മീ./സെ. ആകെ ദൂരം = 240 + 360 = 600 മീ. സമയം = 600/15 = 40 സെക്കൻഡ്.","lang":"ml","calc":"(240+360)/(240/16)"},
{"k":"quant-1008","cat":"quant","s":"quant","t":"Boats and streams","lvl":"recruit","exam":"Kerala PSC","psc":"degree","d":"hard","q":"നിശ്ചലജലത്തിൽ മണിക്കൂറിൽ 9 കി.മീ. വേഗമുള്ള ഒരു ബോട്ടിന് ഒരു നിശ്ചിത ദൂരം ഒഴുക്കിനെതിരെ സഞ്ചരിക്കാൻ, അതേ ദൂരം ഒഴുക്കിനനുകൂലമായി സഞ്ചരിക്കാൻ എടുക്കുന്നതിന്റെ ഇരട്ടി സമയം വേണം. ഒഴുക്കിന്റെ വേഗം എത്ര?","o":["3 കി.മീ./മണിക്കൂർ","2 കി.മീ./മണിക്കൂർ","4 കി.മീ./മണിക്കൂർ","4.5 കി.മീ./മണിക്കൂർ"],"a":0,"e":"9 + s = 2(9 − s) ⇒ 3s = 9 ⇒ s = 3 കി.മീ./മണിക്കൂർ.","lang":"ml","calc":"9/3"},
{"k":"quant-1009","cat":"quant","s":"quant","t":"Ratio","lvl":"recruit","exam":"Kerala PSC","psc":"sslc","d":"easy","q":"3x = 5y ആയാൽ x : y എത്ര?","o":["3 : 5","5 : 3","15 : 1","8 : 3"],"a":1,"e":"x/y = 5/3, അതിനാൽ x : y = 5 : 3.","lang":"ml","nocalc":true},
{"k":"quant-1010","cat":"quant","s":"quant","t":"Problems on ages","lvl":"recruit","exam":"Kerala PSC","psc":"sslc","d":"medium","q":"3 വർഷത്തെ ഇടവേളകളിൽ ജനിച്ച 5 കുട്ടികളുടെ ഇപ്പോഴത്തെ വയസ്സുകളുടെ തുക 50 ആണ്. ഏറ്റവും ഇളയ കുട്ടിയുടെ വയസ്സ് എത്ര?","o":["5 വയസ്സ്","6 വയസ്സ്","4 വയസ്സ്","8 വയസ്സ്"],"a":2,"e":"x + (x+3) + (x+6) + (x+9) + (x+12) = 50 ⇒ 5x + 30 = 50 ⇒ x = 4 വയസ്സ്.","lang":"ml","calc":"(50-30)/5"},
{"k":"quant-1011","cat":"quant","s":"quant","t":"Average","lvl":"recruit","exam":"Kerala PSC","psc":"sslc","d":"easy","q":"12, 18, 25, 30, 40 എന്നീ സംഖ്യകളുടെ ശരാശരി എത്ര?","o":["25","24","26","27"],"a":0,"e":"തുക = 125; ശരാശരി = 125/5 = 25.","lang":"ml","calc":"(12+18+25+30+40)/5"},
{"k":"quant-1012","cat":"quant","s":"quant","t":"Alligation","lvl":"recruit","exam":"Kerala PSC","psc":"degree","d":"hard","q":"കിലോയ്ക്ക് ₹62 വിലയുള്ള തേയിലയും കിലോയ്ക്ക് ₹72 വിലയുള്ള തേയിലയും ഏത് അനുപാതത്തിൽ കലർത്തിയാൽ മിശ്രിതത്തിന്റെ വില കിലോയ്ക്ക് ₹64.50 ആകും?","o":["1 : 3","2 : 1","5 : 2","3 : 1"],"a":3,"e":"(72 − 64.50) : (64.50 − 62) = 7.5 : 2.5 = 3 : 1.","lang":"ml","nocalc":true},
{"k":"quant-1013","cat":"quant","s":"quant","t":"Perfect squares","lvl":"recruit","exam":"Kerala PSC","psc":"plus2","d":"medium","q":"2000-ൽ നിന്ന് ഏറ്റവും കുറഞ്ഞത് എത്ര കുറച്ചാൽ ഒരു പൂർണവർഗം കിട്ടും?","o":["25","64","36","44"],"a":1,"e":"44² = 1936, 45² = 2025. 2000 − 1936 = 64.","lang":"ml","calc":"2000-44^2"},
{"k":"quant-1014","cat":"quant","s":"quant","t":"LCM","lvl":"recruit","exam":"Kerala PSC","psc":"sslc","d":"easy","q":"15, 20, 25 എന്നീ സംഖ്യകളുടെ ല.സാ.ഗു. (LCM) എത്ര?","o":["150","600","300","900"],"a":2,"e":"15 = 3 × 5, 20 = 2² × 5, 25 = 5². ല.സാ.ഗു. = 2² × 3 × 5² = 300.","lang":"ml","calc":"2^2*3*5^2"},
{"k":"quant-1015","cat":"quant","s":"quant","t":"Mensuration (rectangle)","lvl":"recruit","exam":"Kerala PSC","psc":"plus2","d":"medium","q":"ഒരു ചതുരത്തിന്റെ നീളവും വീതിയും 4 : 3 എന്ന അനുപാതത്തിലാണ്. അതിന്റെ വികർണ്ണം 25 മീ. ആയാൽ ചുറ്റളവ് എത്ര?","o":["70 മീ.","60 മീ.","84 മീ.","100 മീ."],"a":0,"e":"നീളം 4k, വീതി 3k ⇒ വികർണ്ണം 5k = 25 ⇒ k = 5. നീളം 20, വീതി 15; ചുറ്റളവ് = 2(20 + 15) = 70 മീ.","lang":"ml","calc":"2*(20+15)"},
{"k":"quant-1016","cat":"quant","s":"quant","t":"Simplification","lvl":"recruit","exam":"Kerala PSC","psc":"sslc","d":"easy","q":"125 × 8 ÷ 25 + 17-ന്റെ വില എത്ര?","o":["47","67","77","57"],"a":3,"e":"125 × 8 = 1000; 1000 ÷ 25 = 40; 40 + 17 = 57.","lang":"ml","calc":"125*8/25+17"},
{"k":"quant-1017","cat":"quant","s":"quant","t":"Partnership","lvl":"recruit","exam":"Kerala PSC","psc":"degree","d":"hard","q":"A-യും B-യും 3 : 5 എന്ന അനുപാതത്തിൽ മൂലധനം മുടക്കി ഒരു കച്ചവടം തുടങ്ങി. A 6 മാസത്തേക്കാണ് മുടക്കിയത്. ലാഭം 9 : 10 എന്ന അനുപാതത്തിൽ വീതിച്ചുവെങ്കിൽ B എത്ര മാസത്തേക്കാണ് മുടക്കിയത്?","o":["3 മാസം","4 മാസം","5 മാസം","6 മാസം"],"a":1,"e":"(3 × 6) : (5 × t) = 9 : 10 ⇒ 180 = 45t ⇒ t = 4 മാസം.","lang":"ml","calc":"18*10/(9*5)"},
{"k":"quant-1018","cat":"quant","s":"quant","t":"Speed, time and distance","lvl":"recruit","exam":"Kerala PSC","psc":"degree","d":"advanced","q":"300 കി.മീ. അകലെയുള്ള P, Q എന്നീ സ്ഥലങ്ങളിൽ നിന്ന് രണ്ട് കാറുകൾ ഒരേ സമയം പരസ്പരം നേർക്ക് പുറപ്പെടുന്നു. കണ്ടുമുട്ടിയ ശേഷം P-യിൽ നിന്നുള്ള കാർ Q-യിൽ എത്താൻ 4 മണിക്കൂറും Q-യിൽ നിന്നുള്ള കാർ P-യിൽ എത്താൻ 9 മണിക്കൂറും എടുക്കുന്നു. P-യിൽ നിന്നുള്ള കാറിന്റെ വേഗം എത്ര?","o":["20 കി.മീ./മണിക്കൂർ","25 കി.മീ./മണിക്കൂർ","30 കി.മീ./മണിക്കൂർ","36 കി.മീ./മണിക്കൂർ"],"a":2,"e":"കണ്ടുമുട്ടാനെടുത്ത സമയം = √(4 × 9) = 6 മണിക്കൂർ. P-യിൽ നിന്നുള്ള കാറിന്റെ ആകെ സമയം 6 + 4 = 10 മണിക്കൂർ; വേഗം = 300/10 = 30 കി.മീ./മണിക്കൂർ.","lang":"ml","calc":"300/(sqrt(4*9)+4)"},
{"k":"quant-1019","cat":"quant","s":"quant","t":"Profit and loss","lvl":"recruit","exam":"Kerala PSC","psc":"plus2","d":"medium","q":"ഒരു സാധനം ₹1080-ന് വിറ്റപ്പോൾ 10% നഷ്ടം വന്നു. 15% ലാഭം കിട്ടാൻ അത് എത്ര രൂപയ്ക്ക് വിൽക്കണം?","o":["₹1380","₹1242","₹1320","₹1350"],"a":0,"e":"വാങ്ങിയ വില = 1080 × 100/90 = ₹1200. 15% ലാഭത്തിന് വിൽക്കേണ്ട വില = 1200 × 115/100 = ₹1380.","lang":"ml","calc":"1080*100/90*115/100"}
]
